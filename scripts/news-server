#!/bin/bash
# Django 后端服务控制
set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
LOG_DIR="$PROJECT/logs"
LOG="$LOG_DIR/django.log"
PID_FILE="$LOG_DIR/django.pid"
mkdir -p "$LOG_DIR"

PYTHON="$PROJECT/backend/venv/bin/python"
if [ ! -x "$PYTHON" ]; then
  PYTHON="${PYTHON_BIN:-python3}"
fi
CMD=("$PYTHON" manage.py runserver 0.0.0.0:9527 --noreload)

start() {
  if status; then
    echo "Django 已在运行 (PID $(cat "$PID_FILE"))"
    return 0
  fi
  cd "$PROJECT/backend"
  nohup "${CMD[@]}" >> "$LOG" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 2
  if kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "Django 已启动 (PID $(cat "$PID_FILE"), port 9527)"
  else
    echo "启动失败，查看日志: $LOG"
    rm -f "$PID_FILE"
    return 1
  fi
}

stop() {
  if [ -f "$PID_FILE" ]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null
    rm -f "$PID_FILE"
    echo "Django 已停止"
  else
    echo "Django 未在运行"
  fi
}

status() {
  if [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    return 0
  fi
  return 1
}

case "${1:-help}" in
  start)  start ;;
  stop)   stop ;;
  status) if status; then echo "Django 运行中"; else echo "Django 未运行"; fi ;;
  restart) stop; sleep 1; start ;;
  log)    tail -f "$LOG" ;;
  *)
    echo "用法: news-server {start|stop|restart|status|log}"
    ;;
esac
