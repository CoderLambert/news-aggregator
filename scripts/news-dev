#!/bin/bash
# 前端开发服务器控制 (Vite)
set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
PROJECT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
LOG_DIR="$PROJECT/logs"
LOG="$LOG_DIR/vite.log"
PID_FILE="$LOG_DIR/vite.pid"
mkdir -p "$LOG_DIR"

VITE_BIN="$PROJECT/frontend/node_modules/.bin/vite"
if [ -x "$VITE_BIN" ]; then
  CMD=("$VITE_BIN" --host 0.0.0.0)
else
  CMD=(npx vite --host 0.0.0.0)
fi

start() {
  if status; then
    echo "Vite 已在运行 (PID $(cat "$PID_FILE"))"
    return 0
  fi
  cd "$PROJECT/frontend"
  nohup "${CMD[@]}" >> "$LOG" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 3
  if kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "Vite 已启动 (PID $(cat "$PID_FILE"))"
  else
    echo "启动失败，查看日志: $LOG"
    rm -f "$PID_FILE"
    return 1
  fi
}

stop() {
  if [ -f "$PID_FILE" ]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null
    rm -f "$PID_FILE"
    echo "Vite 已停止"
  else
    echo "Vite 未在运行"
  fi
}

status() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

case "${1:-help}" in
  start)   start ;;
  stop)    stop ;;
  status)  if status; then echo "Vite 运行中"; else echo "Vite 未运行"; fi ;;
  restart) stop; sleep 1; start ;;
  build)   cd "$PROJECT/frontend" && "${CMD[@]}" build ;;
  log)     tail -f "$LOG" ;;
  *)
    echo "用法: news-dev {start|stop|restart|status|build|log}"
    echo "  build - 构建前端生产版本"
    ;;
esac
