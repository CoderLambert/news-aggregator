#!/bin/bash
# 前端开发服务器控制 (Vite)
PROJECT=/root/news-aggregator
LOG=$PROJECT/logs/vite.log
PID_FILE=$PROJECT/logs/vite.pid
CMD="npx vite --host 0.0.0.0"

start() {
  if status; then
    echo "Vite 已在运行 (PID $(cat "$PID_FILE"))"
    return 0
  fi
  cd "$PROJECT/frontend"
  nohup $CMD >> "$LOG" 2>&1 &
  echo $! > "$PID_FILE"
  sleep 3
  if kill -0 "$(cat "$PID_FILE")" 2>/dev/null; then
    echo "Vite 已启动 (PID $(cat "$PID_FILE"))"
  else
    echo "启动失败，查看日志: $LOG"
    rm -f "$PID_FILE"
    return 1
  fi
}

stop() {
  if [ -f "$PID_FILE" ]; then
    kill "$(cat "$PID_FILE")" 2>/dev/null
    rm -f "$PID_FILE"
    echo "Vite 已停止"
  else
    pkill -f "vite" 2>/dev/null && echo "Vite 已停止" || echo "Vite 未在运行"
  fi
}

status() {
  [ -f "$PID_FILE" ] && kill -0 "$(cat "$PID_FILE")" 2>/dev/null
}

case "${1:-help}" in
  start)   start ;;
  stop)    stop ;;
  status)  if status; then echo "Vite 运行中"; else echo "Vite 未运行"; fi ;;
  restart) stop; sleep 1; start ;;
  build)   cd "$PROJECT/frontend" && npx vite build ;;
  log)     tail -f "$LOG" ;;
  *)
    echo "用法: news-dev {start|stop|restart|status|build|log}"
    echo "  build - 构建前端生产版本"
    ;;
esac
