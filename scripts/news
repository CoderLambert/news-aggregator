#!/bin/bash
# NewsHub 统一服务控制命令
set -u

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"

server() { "$SCRIPT_DIR/news-server" "$@"; }
frontend() { "$SCRIPT_DIR/news-dev" "$@"; }

start() {
  server start || return 1
  frontend start || return 1
  echo "NewsHub 前端和后端已启动；订阅源同步由已配置的 RSS 引擎处理"
}

stop() {
  frontend stop || true
  server stop || true
  echo "NewsHub 前端和后端已停止"
}

status() {
  echo "[后端]"
  server status || true
  echo "[前端]"
  frontend status || true
}

health() {
  local result=0
  echo "[后端与依赖]"
  server health || result=1
  echo "[前端]"
  frontend health || result=1
  return "$result"
}

restart() {
  stop
  start
}

logs() {
  case "${1:-all}" in
    backend|server) server log ;;
    frontend|dev) frontend log ;;
    all)
      echo "用法: $0 log {backend|frontend}"
      echo "服务日志分别位于 logs/django.log、logs/vite.log"
      ;;
    *)
      echo "用法: $0 log {backend|frontend}"
      return 1
      ;;
  esac
}

case "${1:-help}" in
  start)   start ;;
  stop)    stop ;;
  restart) restart ;;
  status)  status ;;
  health)  health ;;
  build)   frontend build ;;
  crawl)   echo "旧抓取入口已退役，请在频道页面管理订阅源。" >&2; exit 2 ;;
  log|logs) logs "${2:-all}" ;;
  *)
    echo "用法: news {start|stop|restart|status|health|build|log}"
    echo "  start   - 启动前端和后端"
    echo "  stop    - 停止前端和后端"
    echo "  restart - 重启全部服务"
    echo "  status  - 查看全部服务状态"
    echo "  health  - 检查前端、数据库及所有已配置的后台服务"
    echo "  build   - 构建前端生产资源"
    echo "  log     - 查看指定服务日志"
    ;;
esac
