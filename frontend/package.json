{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "dev:proxy": "./dev-server.sh start",
    "dev:stop": "./dev-server.sh stop",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:ui": "vitest --ui",
    "typecheck": "tsc --noEmit",
    "dev:mock": "vite --config vite.mock.config.js --mode mock",
    "mock:backend": "node --experimental-strip-types scripts/mock-backend.mjs",
    "mock:catalog": "node --experimental-strip-types scripts/scenario-catalog.mjs",
    "mock:drift": "node scripts/check-scenario-source.mjs",
    "test:scenarios:core": "node --experimental-strip-types --test tests/scenarios/*.test.mjs",
    "test:scenarios:integration": "vitest run tests/scenarios/contracts.test.ts tests/scenarios/transport.test.ts tests/scenarios/read-state.test.tsx",
    "test:scenarios:e2e": "playwright test --config playwright.scenarios.config.mjs",
    "typecheck:scenarios": "tsc --noEmit -p tsconfig.scenarios.json",
    "check:production-mocks": "node scripts/assert-no-mock-assets.mjs dist",
    "build:checked": "npm run build && npm run check:production-mocks"
  },
  "dependencies": {
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@shikijs/core": "^4.1.0",
    "@shikijs/engine-javascript": "^4.1.0",
    "@shikijs/langs": "^4.1.0",
    "@shikijs/themes": "^4.1.0",
    "@tailwindcss/vite": "^4.3.0",
    "@tanstack/react-query": "^5.104.1",
    "axios": "^1.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "dompurify": "3.4.7",
    "gsap": "^3.15.0",
    "lucide-react": "^1.17.0",
    "mermaid": "^11.15.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-error-boundary": "^6.1.2",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.15.1",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.1.0",
    "streamdown": "^2.7.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tw-animate-css": "^1.4.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^4.1.7",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.12",
    "vitest": "^4.1.7",
    "msw": "3.0.3",
    "@playwright/test": "1.64.1"
  },
  "packageManager": "npm@11.19.0"
}
