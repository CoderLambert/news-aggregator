# Copy to a protected production environment file and fill in deployment
# values. Production settings do not load this file automatically.
DJANGO_ENV=production
DJANGO_DEBUG=0

# Required: generate a unique key (for example, python -c 'import secrets; print(secrets.token_urlsafe(48))')
# and store it in the deployment secret manager. Use at least 50 characters.
DJANGO_SECRET_KEY=

# Production accepts exactly this host and origin.
DJANGO_ALLOWED_HOSTS=news.lambert.host
DJANGO_CSRF_TRUSTED_ORIGINS=https://news.lambert.host

# Public Beta defaults. G1 is server-side read-only.
PUBLIC_SITE_MODE=read_only
PUBLIC_SIGNUP_ENABLED=0
PUBLIC_AI_ENABLED=0
CHATGPT_PLAN_USAGE_ENABLED=0
CHATGPT_AUTH_MODE=disabled

# Required single peer address for the host-network production deployment.
# Keep explicit; wildcards, networks, lists, and hostnames fail.
WAITRESS_TRUSTED_PROXY=127.0.0.1

# Production network_mode: host binds only to loopback; the Nginx upstream is
# fixed to 127.0.0.1:9527. Do not change this for production.
WAITRESS_PORT=9527

# Existing Waitress defaults; each value must be a positive integer.
TERMUX_MODE=0
WAITRESS_THREADS=4
WAITRESS_CONN_LIMIT=1000
