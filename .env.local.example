# NewsHub 本机源码部署推荐配置。
# 从项目根目录复制为 .env 后使用；所有相对路径都以项目根目录为基准。
# 仅用于绑定 127.0.0.1 的本机部署，不可直接用于公网生产环境。

# ========== Django 与本机数据 ==========
DJANGO_ENV=development
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_CSRF_TRUSTED_ORIGINS=http://127.0.0.1:9527,http://localhost:9527,http://127.0.0.1:5173,http://localhost:5173

# 必须替换为以下命令生成的稳定随机值：
# python3 -c "from secrets import token_urlsafe; print(token_urlsafe(60))"
DJANGO_SECRET_KEY=REPLACE_WITH_A_STABLE_RANDOM_SECRET
# 留空时沿用 DJANGO_SECRET_KEY。接管旧数据库时必须沿用旧值。
CHATGPT_TOKEN_ENCRYPTION_KEY=
PROVIDER_CREDENTIAL_ENCRYPTION_KEY=

DJANGO_DB_PATH=.runtime/live.sqlite3
CHROMA_DATA_DIR=.runtime/chroma
TTS_CACHE_DIR=.runtime/tts
CHATGPT_DEPLOYMENT_INSTANCE_FILE=.runtime/chatgpt-deployment-id

# ========== 默认开放的本机功能 ==========
PUBLIC_SITE_MODE=full
PUBLIC_SIGNUP_ENABLED=1
PUBLIC_AI_ENABLED=1
CHATGPT_PLAN_USAGE_ENABLED=1
CHATGPT_AUTH_MODE=local_oss

# 当前默认 Edge TTS 地址在部分网络返回 403；本机推荐使用已验证的兼容端点。
EDGE_TTS_ENDPOINT=msedgeservices

# ========== 用户自带模型能力 ==========
# ChatGPT local_oss 可由每个用户连接自己的订阅。
# 其他厂商 Key 通过设置页保存；启用 LiteLLM BYOK 时在本机启动网关并填写项目 Key。
AI_BYOK_GATEWAY_URL=http://127.0.0.1:4000
AI_BYOK_GATEWAY_PROJECT_KEY=
# Jina 无 Key 也可使用基础额度；填写后可提高研究搜索与正文后备读取额度。
JINA_API_KEY=

# ========== 全文获取与结构化正文 ==========
FULL_CONTENT_WORKER_ENABLED=1
FULL_CONTENT_AUTO_ENQUEUE_ENABLED=1
FULL_CONTENT_AUTO_SOURCE_KEYS=devto,webkit,smashing_magazine,v8,mozilla_hacks,svelte_blog,angular_blog,bbc,techcrunch,css_tricks,webdev,chrome_dev,react_blog,openai_blog,deepmind,infoq,ars_technica_ai,mit_tech_review_ai,anthropic,mistral,venturebeat_ai
FULL_CONTENT_WORKER_LOCK=.runtime/full-content.lock
FULL_CONTENT_WORKER_HEARTBEAT=.runtime/full-content-heartbeat.json
STRUCTURED_BODY_INGEST_ENABLED=1
STRUCTURED_BODY_SOURCE_KEYS=devto,webkit,smashing_magazine,v8,mozilla_hacks,svelte_blog,angular_blog,techcrunch
TECHCRUNCH_WP_ENABLED=1

# ========== 新闻爬虫调度 ==========
CRAWLER_SCHEDULER_ENABLED=1
CRAWL_INTERVAL_SECONDS=3600
CRAWL_RUN_ON_START=1
CRAWLER_WORKER_POLL_SECONDS=2
CRAWLER_LOG_DIR=.runtime/crawler
CRAWLER_WORKER_LOCK=.runtime/crawler-worker.lock

# ========== 本地语义索引 ==========
SEARCH_INDEX_ENABLED=1
SEARCH_INDEX_INTERVAL_SECONDS=300
SEARCH_INDEX_BATCH_SIZE=100
SEARCH_INDEX_WORKER_POLL_SECONDS=2
SEARCH_INDEX_WORKER_LOCK=.runtime/search-index-worker.lock

# ========== 智能频道后台任务 ==========
CHANNEL_WORKER_HEARTBEAT=.runtime/channel-worker-heartbeat.json

# 普通电脑使用 4 个 Waitress 线程；低资源设备可改 TERMUX_MODE=1、WAITRESS_THREADS=2。
TERMUX_MODE=0
WAITRESS_PORT=9527
WAITRESS_THREADS=4
WAITRESS_CONN_LIMIT=1000
