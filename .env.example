# ========== Django ==========
# Generate one-time with: python -c "from secrets import token_urlsafe; print(token_urlsafe(60))"
DJANGO_SECRET_KEY=
# Optional separate key for local ChatGPT subscription tokens. If empty, the
# stable DJANGO_SECRET_KEY above is used. Keep the selected key when moving an
# existing database, otherwise saved subscription tokens cannot be decrypted.
CHATGPT_TOKEN_ENCRYPTION_KEY=
# Normally leave these empty. The app creates a deployment-local UUID under
# backend/.runtime and uses it to allocate one stable OAuth host for this app
# installation. Set CHATGPT_DEPLOYMENT_INSTANCE_ID only for immutable filesystems;
# never reuse one UUID across different machines or deployments.
CHATGPT_DEPLOYMENT_INSTANCE_ID=
CHATGPT_DEPLOYMENT_INSTANCE_FILE=
DJANGO_DEBUG=1
# Comma-separated. Use * for any host in dev (already the default).
DJANGO_ALLOWED_HOSTS=*

# ========== LLM Providers ==========
# Primary: Volcengine ARK (deepseek-v4-pro) — model set in backend/api/services/llm_translator.py
# https://www.volcengine.com/docs/82379
VOLCENGINE_API_KEY=

# Fallback: DashScope Coding Plan (Kimi k2.5)
# https://help.aliyun.com/zh/dashscope
DASHSCOPE_CODING_API_KEY=

# ========== Optional ==========
# If unset, llm_translator.py also tries reading from ~/.hermes/config.yaml
# (legacy compatibility — prefer DASHSCOPE_CODING_API_KEY in this .env)

# Jina AI — used by the research agent for web search and page fetching.
# Free tier works without a key; setting this raises rate limits.
JINA_API_KEY=

# ========== Termux / Mobile Optimization ==========
# Set to 1 on low-resource devices (Termux, Raspberry Pi, etc.):
#   - Reduces Waitress threads (2 instead of 4)
#   - Lowers Scrapy concurrency (see crawler/settings.py)
# Defaults to 0 if unset (normal server behavior).
TERMUX_MODE=0

# ========== Crawler Scheduler ==========
# Docker starts a dedicated crawler worker automatically. The settings can
# then be changed from the superuser-only /admin/crawlers control console.
CRAWLER_SCHEDULER_ENABLED=1
CRAWL_INTERVAL_SECONDS=3600
CRAWL_RUN_ON_START=1
CRAWLER_WORKER_POLL_SECONDS=2

# ========== Semantic Search Index ==========
# A dedicated local worker reconciles News rows into ChromaDB. It never calls
# translation providers or external LLM APIs. These values initialize the
# database settings; later changes are made in the superuser control console.
SEARCH_INDEX_ENABLED=1
SEARCH_INDEX_INTERVAL_SECONDS=300
SEARCH_INDEX_BATCH_SIZE=100
SEARCH_INDEX_WORKER_POLL_SECONDS=2
